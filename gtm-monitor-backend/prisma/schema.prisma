datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  occRate  Float?    // Nilai OCC BRANCH langsung dari file Excel (0.0 - 1.0)
  gapWoW   Float?    // Nilai GAP WOW dari file Excel (delta minggu ke minggu)
  projects Project[]
  users    User[]
}

model ImportMeta {
  id            Int      @id @default(autoincrement())
  key           String   @unique  // e.g. "jateng_diy_summary"
  occRate       Float?   // Total Occupancy Rate Jateng DIY
  available     Int?     // Total Port Tersedia Jateng DIY
  used          Int?     // Total Port Terpakai
  total         Int?     // Total Port Keseluruhan
  gapWoW        Float?   // GAP WOW regional
  updatedAt     DateTime @updatedAt
}


model Project {
  id         String                 @id @default(uuid())
  name       String
  wok        String
  typeDesign String?                @default("Greenfield")
  branch     Branch                 @relation(fields: [branchId], references: [id])
  branchId   Int
  odps       Odp[]
  activities ProjectActivity[]
  photos     ProjectActivityPhoto[]
}

model Odp {
  id         String     @id @default(uuid())
  odp        String     @unique
  avai       Int
  used       Int
  total      Int
  lat        Float?
  lon        Float?
  occStatus  String?    @default("GREEN")
  project    Project    @relation(fields: [projectId], references: [id])
  projectId  String
  activities Activity[]
}

model Activity {
  id         String    @id @default(uuid())
  type       String
  status     String    @default("belum") // "belum", "sudah_upload", "verified"
  photoUrl   String?
  planDate   DateTime?
  actualDate DateTime?
  keterangan String?
  
  odp        Odp       @relation(fields: [odpId], references: [id], onDelete: Cascade)
  odpId      String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([odpId, type])
}

model ProjectActivity {
  id         String    @id @default(uuid())
  type       String
  status     String    @default("belum") // "belum", "upload", "verified"
  photoUrl   String?
  planDate   DateTime?
  actualDate DateTime?
  keterangan String?

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  user       User?     @relation(fields: [userId], references: [id])
  userId     Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, type])
}

model ProjectActivityPhoto {
  id         String    @id @default(uuid())
  type       String    // "tsel_menyapa", "branding_outlet", "bumdes", "rekrutmen_sf", "open_table"
  status     String    @default("upload") // "upload" (Menunggu Verifikasi), "verified"
  photoUrl   String?
  planDate   DateTime?
  namaOutlet String?
  namaBumdes String?
  kodeSf     String?
  keterangan String?

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  user       User?     @relation(fields: [userId], references: [id])
  userId     Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model User {
  id         Int                    @id @default(autoincrement())
  username   String                 @unique
  password   String                 // Hashed password
  fullName   String
  role       String                 @default("USER") // "USER" | "ADMIN"
  branch     Branch?                @relation(fields: [branchId], references: [id])
  branchId   Int?                   // Null jika ADMIN
  activities ProjectActivity[]
  photos     ProjectActivityPhoto[]
  createdAt  DateTime               @default(now())
}


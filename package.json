{
  "name": "gtm-activity-monitoring",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"node gtm-monitor-backend/server.js\" \"npm run dev --prefix gtm-monitor-react\"",
    "backend": "node gtm-monitor-backend/server.js",
    "frontend": "npm run dev --prefix gtm-monitor-react",
    "pm2:start": "pm2 start ecosystem.config.js && pm2 save",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
